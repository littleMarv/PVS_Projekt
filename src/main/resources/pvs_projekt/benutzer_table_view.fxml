<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Tabellenansicht für Benutzer.
 Liste der Login-Benutzer.
-->
<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Überschrift der Tabellenansicht -->
      <Label layoutX="30.0" layoutY="25.0" text="Benutzerliste" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #203044;" />
      <!-- Suchfeld für eine e Suche nach Benutzern -->
      <TextField fx:id="benutzerSucheTextField" layoutX="30.0" layoutY="75.0" prefHeight="28.0" prefWidth="220.0" promptText="Benutzer suchen" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />
      <!-- Öffnet die Einzelansicht für einen neuen Benutzer -->
      <Button fx:id="benutzerNeuButton" layoutX="272.0" layoutY="75.0" prefHeight="28.0" prefWidth="95.0" text="Neu" style="-fx-background-color: #2f6f67; -fx-border-color: #2f6f67; -fx-text-fill: white; -fx-font-weight: bold;" />
      <!-- Bearbeitet des aktuell ausgewählten Benutzers -->
      <Button fx:id="benutzerBearbeitenButton" layoutX="377.0" layoutY="75.0" prefHeight="28.0" prefWidth="105.0" text="Bearbeiten" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />
      <!-- Löscht des aktuell ausgewählten Benutzers -->
      <Button fx:id="benutzerLoeschenButton" layoutX="492.0" layoutY="75.0" prefHeight="28.0" prefWidth="90.0" text="Löschen" style="-fx-background-color: #f4c7b8; -fx-border-color: #e39a84; -fx-text-fill: #203044;" />
      <!-- Tabelle für alle Benutzer -->
      <TableView fx:id="benutzerTableView" layoutX="30.0" layoutY="120.0" prefHeight="255.0" prefWidth="552.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd;">
         <columns>
            <!-- Benutzer-ID aus benutzer.id -->
            <TableColumn fx:id="benutzerIdColumn" prefWidth="50.0" text="ID" />
            <!-- Benutzername aus benutzer.username -->
            <TableColumn fx:id="benutzernameColumn" prefWidth="120.0" text="Benutzername" />
            <!-- E-Mail-Adresse aus benutzer.email -->
            <TableColumn fx:id="emailColumn" prefWidth="145.0" text="E-Mail" />
            <!-- Benutzerrolle über benutzer.rollen_id -->
            <TableColumn fx:id="rolleColumn" prefWidth="85.0" text="Rolle" />
            <!-- Zugeordneter Mitarbeiter über benutzer.mitarbeiter_id -->
            <TableColumn fx:id="mitarbeiterColumn" prefWidth="95.0" text="Mitarbeiter" />
            <!-- Aktiv-Status aus benutzer.is_active -->
            <TableColumn fx:id="aktivColumn" prefWidth="55.0" text="Aktiv" />
         </columns>
      </TableView>
   </children>
</AnchorPane>