<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Login-Maske der Anwendung.
 Hier meldet sich der Benutzer mit Name/E-Mail und Passwort an.
-->
<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Überschrift der Login-Maske -->
      <Label layoutX="40.0" layoutY="35.0" text="PVS Login" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #203044;" />
      <!-- Eingabe für Benutzername oder E-Mail-Adresse -->
      <Label layoutX="95.0" layoutY="105.0" text="Name / E-Mail" style="-fx-text-fill: #203044; -fx-font-weight: bold;" />
      <TextField fx:id="namemail" layoutX="220.0" layoutY="100.0" prefHeight="25.0" prefWidth="220.0" promptText="Name oder E-Mail eingeben" style="-fx-background-color: white; -fx-border-color: #c7d1dd;" />
      <!-- Eingabe für das Passwort -->
      <Label layoutX="95.0" layoutY="150.0" text="Passwort" style="-fx-text-fill: #203044; -fx-font-weight: bold;" />
      <PasswordField fx:id="passwort" layoutX="220.0" layoutY="145.0" prefHeight="25.0" prefWidth="220.0" promptText="Passwort eingeben" style="-fx-background-color: white; -fx-border-color: #c7d1dd;" />
      <!-- Dieses Label kann Fehlermeldungen anzeigen -->
      <Label fx:id="meldungLabel" layoutX="220.0" layoutY="185.0" prefWidth="260.0" text="" style="-fx-text-fill: #b94a35;" />
      <!-- Button zum Anmelden -->
      <Button fx:id="login" layoutX="220.0" layoutY="225.0" mnemonicParsing="false" prefWidth="220.0" text="Login" style="-fx-background-color: #2f6f67; -fx-border-color: #2f6f67; -fx-text-fill: white; -fx-font-weight: bold;" />
   </children>
</AnchorPane>