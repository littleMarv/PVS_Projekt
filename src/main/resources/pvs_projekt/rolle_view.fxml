<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Einzelansicht für eine Benutzerrolle.
 Maske zum Anlegen und Bearbeiten einer Login-Rolle.
-->
<AnchorPane prefHeight="260.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@css/pvs_style.css" styleClass="view-root">
  <children>
    <!-- Überschrift der Maske -->
    <Label layoutX="40.0" layoutY="28.0" text="Benutzerrolle bearbeiten" styleClass="view-title" />
    <!-- Bezeichnung aus rollen.bezeichnung -->
    <Label layoutX="82.0" layoutY="91.0" text="Bezeichnung" styleClass="field-label" />
    <TextField fx:id="rolleBezeichnungTextField" layoutX="213.0" layoutY="86.0" prefHeight="25.0" prefWidth="220.0" promptText="Bezeichnung eingeben" styleClass="input-field" />
    <!-- Speichert die Rolle -->
    <Button fx:id="rolleSpeichernButton" layoutX="213.0" layoutY="150.0" mnemonicParsing="false" prefWidth="105.0" text="Speichern" styleClass="primary-button" />
    <!-- Bricht die Eingabe ab und geht zurück -->
    <Button fx:id="rolleAbbrechenButton" layoutX="328.0" layoutY="150.0" mnemonicParsing="false" prefWidth="105.0" text="Abbrechen" styleClass="secondary-button" />
  </children>
</AnchorPane>
