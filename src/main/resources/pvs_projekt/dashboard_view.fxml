<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Dashboard der Anwendung.
 Startseite im mittleren Bereich der Hauptmaske.
-->
<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController" stylesheets="@css/pvs_style.css" styleClass="view-root">
  <children>
    <!-- Überschrift der Startseite -->
    <Label layoutX="30.0" layoutY="25.0" text="Dashboard" styleClass="view-title" />
    <!-- Kleine Übersichtskacheln für e Kennzahlen -->
    <AnchorPane layoutX="30.0" layoutY="85.0" prefHeight="90.0" prefWidth="120.0" styleClass="dashboard-card">
      <children>
        <Label layoutX="14.0" layoutY="14.0" text="Mitarbeiter" styleClass="card-title" />
        <Label layoutX="14.0" layoutY="46.0" text="0" fx:id="mitarbeiterAnzahlLabel" styleClass="dashboard-number" />
      </children>
    </AnchorPane>
    <AnchorPane layoutX="170.0" layoutY="85.0" prefHeight="90.0" prefWidth="120.0" styleClass="dashboard-card">
      <children>
        <Label layoutX="14.0" layoutY="14.0" text="Projekte" styleClass="card-title" />
        <Label layoutX="14.0" layoutY="46.0" text="0" fx:id="projekteAnzahlLabel" styleClass="dashboard-number" />
      </children>
    </AnchorPane>
    <AnchorPane layoutX="310.0" layoutY="85.0" prefHeight="90.0" prefWidth="120.0" styleClass="dashboard-card">
      <children>
        <Label layoutX="14.0" layoutY="14.0" text="Tickets" styleClass="card-title" />
        <Label layoutX="14.0" layoutY="46.0" text="0" fx:id="ticketsAnzahlLabel" styleClass="dashboard-number" />
      </children>
    </AnchorPane>
    <AnchorPane layoutX="450.0" layoutY="85.0" prefHeight="90.0" prefWidth="120.0" styleClass="dashboard-card">
      <children>
        <Label layoutX="14.0" layoutY="14.0" text="Orte" styleClass="card-title" />
        <Label layoutX="14.0" layoutY="46.0" text="0" fx:id="orteAnzahlLabel" styleClass="dashboard-number" />
      </children>
    </AnchorPane>
  </children>
</AnchorPane>