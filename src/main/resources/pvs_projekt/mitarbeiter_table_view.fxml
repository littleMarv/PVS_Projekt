<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<!--
    Tabellenansicht für Mitarbeiter.
    Liste der Mitarbeiter.
-->
<AnchorPane prefHeight="530.0"
            prefWidth="810.0"
            style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MitarbeiterTableViewController">
   <children>
      <!-- Überschrift der Tabellenansicht -->
      <Label layoutX="30.0"
             layoutY="25.0"
             text="Mitarbeiterliste"
             style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #203044;" />

      <!-- Suchfeld für Mitarbeiter -->
      <TextField fx:id="mitarbeiterSucheTextField"
                 layoutX="30.0"
                 layoutY="75.0"
                 prefHeight="28.0"
                 prefWidth="300.0"
                 promptText="Mitarbeiter suchen"
                 style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />

      <!-- Öffnet die Einzelansicht für einen neuen Mitarbeiter -->
      <Button fx:id="mitarbeiterNeuButton"
              layoutX="480.0"
              layoutY="75.0"
              prefHeight="28.0"
              prefWidth="95.0"
              text="Neu"
              style="-fx-background-color: #2f6f67; -fx-border-color: #2f6f67; -fx-text-fill: white; -fx-font-weight: bold;" />

      <!-- Bearbeitet den ausgewählten Mitarbeiter -->
      <Button fx:id="mitarbeiterBearbeitenButton"
              layoutX="585.0"
              layoutY="75.0"
              prefHeight="28.0"
              prefWidth="105.0"
              text="Bearbeiten"
              style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />

      <!-- Löscht den ausgewählten Mitarbeiter -->
      <Button fx:id="mitarbeiterLoeschenButton"
              layoutX="700.0"
              layoutY="75.0"
              prefHeight="28.0"
              prefWidth="80.0"
              text="Löschen"
              style="-fx-background-color: #f4c7b8; -fx-border-color: #e39a84; -fx-text-fill: #203044;" />

      <!-- Tabelle für alle Mitarbeiter -->
      <TableView fx:id="mitarbeiterTable"
                 layoutX="30.0"
                 layoutY="120.0"
                 prefHeight="380.0"
                 prefWidth="750.0"
                 style="-fx-background-color: white; -fx-border-color: #c7d1dd;">
         <columns>
            <!-- Personalnummer aus der Tabelle mitarbeiter -->
            <TableColumn fx:id="personalnummerColumn" prefWidth="70.0" text="PersNr" />

            <!-- Vorname des Mitarbeiters -->
            <TableColumn fx:id="vornameColumn" prefWidth="85.0" text="Vorname" />

            <!-- Nachname des Mitarbeiters -->
            <TableColumn fx:id="nachnameColumn" prefWidth="100.0" text="Nachname" />

            <!-- Geschlecht aus der Tabelle mitarbeiter -->
            <TableColumn fx:id="geschlechtColumn" prefWidth="60.0" text="Geschlecht" />

            <!-- Postleitzahl über mitarbeiter.ort_id und orte.plz -->
            <TableColumn fx:id="plzColumn" prefWidth="50.0" text="PLZ" />

            <!-- Ortsname über mitarbeiter.ort_id und orte.ortsname -->
            <TableColumn fx:id="ortColumn" prefWidth="90.0" text="Ort" />

            <!-- Ressort über mitarbeiter.ressort_id und ressorts.bezeichnung -->
            <TableColumn fx:id="ressortColumn" prefWidth="90.0" text="Ressort" />

            <!-- Geburtsdatum aus der Tabelle mitarbeiter -->
            <TableColumn fx:id="gebDatumColumn" prefWidth="80.0" text="Geb.Datum" />

            <!-- Vertragstyp über mitarbeiter.vertragstyp_id und vertragstypen.bezeichnung -->
            <TableColumn fx:id="vertragstypColumn" prefWidth="90.0" text="Vertragstyp" />
         </columns>
      </TableView>
   </children>
</AnchorPane>