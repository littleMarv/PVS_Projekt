<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Einzelansicht für einen Vertragstyp.
 Vertragstypen beschreiben das Beschäftigungsverhältnis eines Mitarbeiters.
-->
<AnchorPane prefHeight="260.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VertragstypViewController" stylesheets="@css/pvs_style.css" styleClass="view-root">
  <children>
    <!-- Überschrift der Maske -->
    <Label fx:id="vertragstypTitelLabel" layoutX="40.0" layoutY="28.0" text="Vertragstyp anlegen" styleClass="view-title" />
    <!-- Bezeichnung aus vertragstypen.bezeichnung -->
    <Label layoutX="82.0" layoutY="91.0" text="Bezeichnung" styleClass="field-label" />
    <TextField fx:id="vertragstypBezeichnungTextField" layoutX="213.0" layoutY="86.0" prefHeight="25.0" prefWidth="220.0" promptText="Bezeichnung eingeben" styleClass="input-field" />
    <!-- Speichert den Vertragstyp -->
    <Button fx:id="vertragstypSpeichernButton" layoutX="213.0" layoutY="150.0" mnemonicParsing="false" onAction="#vertragstypSpeichern" prefWidth="105.0" text="Speichern" styleClass="primary-button" />
    <!-- Bricht die Eingabe ab und geht zurück -->
    <Button fx:id="vertragstypAbbrechenButton" layoutX="328.0" layoutY="150.0" mnemonicParsing="false" onAction="#vertragstypAbbrechen" prefWidth="105.0" text="Abbrechen" styleClass="secondary-button" />
  </children>
</AnchorPane>
