<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Einzelansicht für einen Vertragstyp.
 Vertragstypen beschreiben das Beschäftigungsverhältnis eines Mitarbeiters.
-->
<AnchorPane prefHeight="260.0" prefWidth="600.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Überschrift der Maske -->
      <Label layoutX="40.0" layoutY="28.0" text="Vertragstyp bearbeiten" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #203044;" />
      <!-- Bezeichnung aus vertragstypen.bezeichnung -->
      <Label layoutX="82.0" layoutY="91.0" text="Bezeichnung" style="-fx-text-fill: #203044; -fx-font-weight: bold;" />
      <TextField fx:id="vertragstypBezeichnungTextField" layoutX="213.0" layoutY="86.0" prefHeight="25.0" prefWidth="220.0" promptText="Bezeichnung eingeben" style="-fx-background-color: white; -fx-border-color: #c7d1dd;" />
      <!-- Speichert; Aktion wird im Controller ergänzt -->
      <Button fx:id="vertragstypSpeichernButton" layoutX="213.0" layoutY="150.0" mnemonicParsing="false" prefWidth="105.0" text="Speichern" style="-fx-background-color: #2f6f67; -fx-border-color: #2f6f67; -fx-text-fill: white; -fx-font-weight: bold;" />
      <!-- Bricht ab oder geht zurück; Aktion wird im Controller ergänzt -->
      <Button fx:id="vertragstypAbbrechenButton" layoutX="328.0" layoutY="150.0" mnemonicParsing="false" prefWidth="105.0" text="Abbrechen" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />
   </children>
</AnchorPane>