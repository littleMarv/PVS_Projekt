<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Tabellenansicht für Tickets.
 Liste der Tickets mit Ausstellern.
-->
<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Überschrift der Tabellenansicht -->
      <Label layoutX="30.0" layoutY="25.0" text="Ticketliste" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #203044;" />
      <!-- Suchfeld für eine e Suche nach Ticketdaten -->
      <TextField fx:id="ticketSucheTextField" layoutX="30.0" layoutY="75.0" prefHeight="28.0" prefWidth="220.0" promptText="Ticket suchen" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />
      <!-- Öffnet die Einzelansicht für ein neues Ticket -->
      <Button fx:id="ticketNeuButton" layoutX="272.0" layoutY="75.0" prefHeight="28.0" prefWidth="95.0" text="Neu" style="-fx-background-color: #2f6f67; -fx-border-color: #2f6f67; -fx-text-fill: white; -fx-font-weight: bold;" />
      <!-- Bearbeitet des aktuell ausgewählten Tickets -->
      <Button fx:id="ticketBearbeitenButton" layoutX="377.0" layoutY="75.0" prefHeight="28.0" prefWidth="105.0" text="Bearbeiten" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />
      <!-- Löscht des aktuell ausgewählten Tickets -->
      <Button fx:id="ticketLoeschenButton" layoutX="492.0" layoutY="75.0" prefHeight="28.0" prefWidth="90.0" text="Löschen" style="-fx-background-color: #f4c7b8; -fx-border-color: #e39a84; -fx-text-fill: #203044;" />
      <!-- Tabelle für alle Tickets -->
      <TableView fx:id="ticketTableView" layoutX="30.0" layoutY="120.0" prefHeight="255.0" prefWidth="552.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd;">
         <columns>
            <!-- Ticket-ID aus der Tabelle ticket -->
            <TableColumn fx:id="ticketIdColumn" prefWidth="45.0" text="ID" />
            <!-- Betroffene Person aus ticket.verursacher_id -->
            <TableColumn fx:id="betroffenColumn" prefWidth="95.0" text="Betroffen" />
            <!-- Grund aus ticket.grund -->
            <TableColumn fx:id="grundColumn" prefWidth="120.0" text="Grund" />
            <!-- Datum aus ticket.zeitpunkt -->
            <TableColumn fx:id="datumColumn" prefWidth="80.0" text="Datum" />
            <!-- Uhrzeit aus ticket.zeitpunkt -->
            <TableColumn fx:id="uhrzeitColumn" prefWidth="70.0" text="Uhrzeit" />
            <!-- Erster Aussteller aus ticket_aussteller -->
            <TableColumn fx:id="ausstellerEinsColumn" prefWidth="95.0" text="Aussteller 1" />
            <!-- Zweiter Aussteller aus ticket_aussteller -->
            <TableColumn fx:id="ausstellerZweiColumn" prefWidth="95.0" text="Aussteller 2" />
         </columns>
      </TableView>
   </children>
</AnchorPane>