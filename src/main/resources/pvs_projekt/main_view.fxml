<?xml version="1.0" encoding="utf-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<!--
 Hauptlayout der Anwendung.
 BorderPane teilt das Fenster in feste Bereiche:
 oben = Kopfbereich, links = Navigation, mitte = Inhalt.
-->
<BorderPane prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainViewController">
   <!-- Oberer Bereich: Titel der Anwendung -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #203044;" BorderPane.alignment="CENTER">
         <padding>
            <Insets left="25.0" right="25.0" />
         </padding>
         <children>
            <!-- Sichtbarer Fenstertitel innerhalb der App -->
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="PVS Projektverwaltung" />
         </children>
      </HBox>
   </top>
   <!-- Linker Bereich: Hauptnavigation zwischen den Modulen -->
   <left>
      <VBox alignment="TOP_CENTER" prefWidth="190.0" spacing="10.0" style="-fx-background-color: #edf2f7;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="15.0" right="15.0" top="65.0" />
         </padding>
         <children>
            <!-- Navigation: Dashboard bleibt erstmal ohne Aktion -->
            <Button fx:id="dashboard" onAction="#dashboardAnzeigen" prefWidth="150.0" style="-fx-background-color: #2f6f67; -fx-border-color: #2f6f67; -fx-text-fill: white; -fx-font-weight: bold;" text="Dashboard" />
            <!-- Dieser Button nutzt die vorhandene Methode im HelloController -->
            <Button fx:id="mitarbeiter" onAction="#mitarbeiterAnzeigen" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" text="Mitarbeiter" />
            <!-- Diese Buttons sind Platzhalter für e Views -->
            <Button fx:id="projekte" onAction="#projekteAnzeigen" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" text="Projekte" />
            <Button fx:id="tickets" onAction="#ticketsAnzeigen" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" text="Tickets" />
            <Button fx:id="orte" onAction="#orteAnzeigen" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" text="Orte" />
            <Button fx:id="ressorts" onAction="#ressortsAnzeigen" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" text="Ressorts" />
            <Button fx:id="vertragstypen" onAction="#vertragstypenAnzeigen" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" text="Vertragstypen" />
            <!-- Leerer Platzhalter, damit der Beenden-Button unten sitzt -->
            <AnchorPane VBox.vgrow="ALWAYS" />
            <!-- Noch ohne Aktion, weil dafür sonst eine Controller-Methode nötig wäre -->
            <Button fx:id="beendenButton" onAction="#beenden" prefWidth="150.0" style="-fx-background-color: #f4c7b8; -fx-border-color: #e39a84; -fx-text-fill: #203044;" text="Beenden" />
         </children>
      </VBox>
   </left>
   <!-- Mittlerer Bereich: Hier werden Tabellen und Formulare angezeigt -->
   <center>
      <AnchorPane fx:id="contentPane" prefHeight="530.0" prefWidth="810.0" style="-fx-background-color: #f8fafc;" BorderPane.alignment="CENTER">
         <children>
            <!-- Startinhalt im Center-Bereich -->
            <Label layoutX="30.0" layoutY="25.0" style="-fx-font-size: 24px; -fx-text-fill: #203044;" text="Dashboard" />
         </children>
      </AnchorPane>
   </center>
</BorderPane>