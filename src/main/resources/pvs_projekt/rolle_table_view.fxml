<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Tabellenansicht für Benutzerrollen.
 Liste der Login-Rollen.
-->
<AnchorPane prefHeight="530.0" prefWidth="810.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@css/pvs_style.css" styleClass="view-root">
  <children>
    <!-- Überschrift der Tabellenansicht -->
    <Label layoutX="30.0" layoutY="25.0" text="Benutzerrollen" styleClass="view-title" />
    <!-- Suchfeld für eine e Suche nach Rollen -->
    <TextField fx:id="rolleSucheTextField" layoutX="30.0" layoutY="75.0" prefHeight="28.0" prefWidth="220.0" promptText="Rolle suchen" styleClass="input-field" />
    <!-- Öffnet die Einzelansicht für eine neue Benutzerrolle -->
    <Button fx:id="rolleNeuButton" layoutX="272.0" layoutY="75.0" prefHeight="28.0" prefWidth="95.0" text="Neu" styleClass="primary-button" />
    <!-- Bearbeitet der aktuell ausgewählten Benutzerrolle -->
    <Button fx:id="rolleBearbeitenButton" layoutX="377.0" layoutY="75.0" prefHeight="28.0" prefWidth="105.0" text="Bearbeiten" styleClass="secondary-button" />
    <!-- Löscht der aktuell ausgewählten Benutzerrolle -->
    <Button fx:id="rolleLoeschenButton" layoutX="492.0" layoutY="75.0" prefHeight="28.0" prefWidth="90.0" text="Löschen" styleClass="danger-button" />
    <!-- Tabelle für alle Benutzerrollen -->
    <TableView fx:id="rolleTableView" layoutX="30.0" layoutY="120.0" prefHeight="380.0" prefWidth="750.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="120.0" AnchorPane.bottomAnchor="30.0" styleClass="data-table">
      <columns>
        <!-- Rollen-ID aus rollen.id -->
        <TableColumn fx:id="rolleIdColumn" prefWidth="90.0" text="ID" />
        <!-- Bezeichnung aus rollen.bezeichnung -->
        <TableColumn fx:id="rolleBezeichnungColumn" prefWidth="460.0" text="Bezeichnung" />
      </columns>
    </TableView>
  </children>
</AnchorPane>