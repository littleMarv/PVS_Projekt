<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Tabellenansicht für Vertragstypen.
 Liste der Beschäftigungsverhältnisse.
-->
<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Überschrift der Tabellenansicht -->
      <Label layoutX="30.0" layoutY="25.0" text="Vertragstypen" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #203044;" />
      <!-- Suchfeld für eine e Suche nach Vertragstypen -->
      <TextField fx:id="vertragstypSucheTextField" layoutX="30.0" layoutY="75.0" prefHeight="28.0" prefWidth="220.0" promptText="Vertragstyp suchen" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />
      <!-- Öffnet die Einzelansicht für einen neuen Vertragstyp -->
      <Button fx:id="vertragstypNeuButton" layoutX="272.0" layoutY="75.0" prefHeight="28.0" prefWidth="95.0" text="Neu" style="-fx-background-color: #2f6f67; -fx-border-color: #2f6f67; -fx-text-fill: white; -fx-font-weight: bold;" />
      <!-- Bearbeitet des aktuell ausgewählten Vertragstyps -->
      <Button fx:id="vertragstypBearbeitenButton" layoutX="377.0" layoutY="75.0" prefHeight="28.0" prefWidth="105.0" text="Bearbeiten" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />
      <!-- Löscht des aktuell ausgewählten Vertragstyps -->
      <Button fx:id="vertragstypLoeschenButton" layoutX="492.0" layoutY="75.0" prefHeight="28.0" prefWidth="90.0" text="Löschen" style="-fx-background-color: #f4c7b8; -fx-border-color: #e39a84; -fx-text-fill: #203044;" />
      <!-- Tabelle für alle Vertragstypen -->
      <TableView fx:id="vertragstypTableView" layoutX="30.0" layoutY="120.0" prefHeight="255.0" prefWidth="552.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd;">
         <columns>
            <!-- Vertragstyp-ID aus vertragstypen.id -->
            <TableColumn fx:id="vertragstypIdColumn" prefWidth="100.0" text="ID" />
            <!-- Bezeichnung aus vertragstypen.bezeichnung -->
            <TableColumn fx:id="vertragstypBezeichnungColumn" prefWidth="450.0" text="Bezeichnung" />
         </columns>
      </TableView>
   </children>
</AnchorPane>