<?xml version="1.0" encoding="utf-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<!--
 Tabellenansicht für Projekte.
 Liste der Projekte.
-->
<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Überschrift der Tabellenansicht -->
      <Label layoutX="30.0" layoutY="25.0" text="Projektliste" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #203044;" />
      <!-- Suchfeld für eine e Suche nach Projekten -->
      <TextField fx:id="projektSucheTextField" layoutX="30.0" layoutY="75.0" prefHeight="28.0" prefWidth="220.0" promptText="Projekt suchen" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />
      <!-- Öffnet die Einzelansicht für ein neues Projekt -->
      <Button fx:id="projektNeuButton" layoutX="272.0" layoutY="75.0" prefHeight="28.0" prefWidth="95.0" text="Neu" style="-fx-background-color: #2f6f67; -fx-border-color: #2f6f67; -fx-text-fill: white; -fx-font-weight: bold;" />
      <!-- Bearbeitet des aktuell ausgewählten Projekts -->
      <Button fx:id="projektBearbeitenButton" layoutX="377.0" layoutY="75.0" prefHeight="28.0" prefWidth="105.0" text="Bearbeiten" style="-fx-background-color: white; -fx-border-color: #c7d1dd; -fx-text-fill: #203044;" />
      <!-- Löscht des aktuell ausgewählten Projekts -->
      <Button fx:id="projektLoeschenButton" layoutX="492.0" layoutY="75.0" prefHeight="28.0" prefWidth="90.0" text="Löschen" style="-fx-background-color: #f4c7b8; -fx-border-color: #e39a84; -fx-text-fill: #203044;" />
      <!-- Tabelle für alle Projekte -->
      <TableView fx:id="projektTableView" layoutX="30.0" layoutY="120.0" prefHeight="255.0" prefWidth="552.0" style="-fx-background-color: white; -fx-border-color: #c7d1dd;">
         <columns>
            <!-- Projekt-ID aus der Datenbank -->
            <TableColumn fx:id="projektIdColumn" prefWidth="55.0" text="ID" />
            <!-- Bezeichnung oder Name des Projekts -->
            <TableColumn fx:id="bezeichnungColumn" prefWidth="205.0" text="Bezeichnung" />
            <!-- Startdatum des Projekts -->
            <TableColumn fx:id="beginnColumn" prefWidth="95.0" text="Beginn" />
            <!-- Abschlussdatum des Projekts -->
            <TableColumn fx:id="abschlussColumn" prefWidth="95.0" text="Abschluss" />
            <!-- Aktuelle Leitung wird aus der Projektbesetzung mit Rolle Projektleitung gelesen -->
            <TableColumn fx:id="projektleitungColumn" prefWidth="100.0" text="Leitung" />
         </columns>
      </TableView>
   </children>
</AnchorPane>